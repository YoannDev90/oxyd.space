---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DNS Propagation Checker" description="Check DNS propagation across 600+ global DNS servers. Free, no auth, instant results.">
  <style is:global>
    .tool {
      margin: 48px auto 20px;
    }
    .tool h1 {
      font-size: clamp(32px, 5vw, 44px);
      font-weight: 800;
      letter-spacing: -.03em;
      margin-bottom: 10px;
    }
    .tool .sub {
      color: var(--muted);
      font-size: 16px;
      margin-bottom: 28px;
    }
    .tool .sub b {
      color: var(--text);
      font-family: var(--mono);
    }

    .map-wrap {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 24px;
      overflow: hidden;
      position: relative;
    }
    .map-hint {
      position: absolute;
      top: 22px;
      right: 22px;
      z-index: 5;
      font-size: 11px;
      color: var(--muted);
      opacity: .6;
      pointer-events: none;
      font-family: var(--mono);
      background: rgba(5, 8, 12, .7);
      padding: 4px 8px;
      border-radius: 6px;
    }
    #map { width: 100%; display: block; cursor: grab; }
    #map:active { cursor: grabbing; }
    #map .land { fill: #0c1520; stroke: #1e2d40; stroke-width: .4; }
    #map .border { fill: none; stroke: #1a2838; stroke-width: .25; }
    #map .graticule { fill: none; stroke: #0d1622; stroke-width: .35; }
    #map .sphere { fill: none; stroke: #182231; stroke-width: .6; }
    .srv-dot { cursor: pointer; }
    .srv-dot:hover { r: 6; }

    .map-legend {
      display: flex;
      gap: 16px;
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      flex-wrap: wrap;
      align-items: center;
    }
    .map-legend span { display: flex; align-items: center; gap: 5px; }
    .map-legend .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .map-legend .dot.pending { background: var(--muted); opacity: .4; }
    .map-legend .dot.ok { background: var(--ok); }
    .map-legend .dot.err { background: var(--bad); }

    .form { display: flex; gap: 10px; flex-wrap: wrap; }
    .input-wrap {
      flex: 1;
      min-width: 200px;
      display: flex;
      align-items: center;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      transition: border-color .15s;
    }
    .input-wrap:focus-within { border-color: var(--accent); }
    .input-wrap input {
      flex: 1;
      min-width: 60px;
      background: transparent;
      border: none;
      outline: none;
      color: var(--text);
      font-family: var(--mono);
      font-size: 15px;
      padding: 12px 14px;
    }
    .input-wrap input::placeholder { color: #4d5f76; }
    select {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      color: var(--text);
      font-family: var(--mono);
      font-size: 14px;
      padding: 12px 14px;
      cursor: pointer;
    }
    select:focus { outline: none; border-color: var(--accent); }

    .results-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 32px;
      margin-bottom: 16px;
    }
    .results-header h2 { font-size: 16px; font-weight: 700; color: var(--muted); }
    .results-header .count { font-family: var(--mono); font-size: 13px; color: var(--muted); }
    .results-grid { display: flex; flex-direction: column; gap: 6px; }
    .srv-card {
      display: grid;
      grid-template-columns: 8px 1fr auto;
      gap: 14px;
      align-items: center;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px 16px;
      font-family: var(--mono);
      font-size: 13px;
      transition: border-color .2s, background .2s;
    }
    .srv-card:hover { border-color: #243448; background: var(--panel-2); }
    .srv-card .dot { width: 8px; height: 8px; border-radius: 50%; }
    .srv-card .dot.ok { background: var(--ok); }
    .srv-card .dot.err { background: var(--bad); }
    .srv-card .info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .srv-card .name { font-weight: 600; color: var(--text); font-size: 13px; }
    .srv-card .region { font-size: 11px; color: var(--muted); }
    .srv-card .result { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; min-width: 0; }
    .srv-card .ips { color: var(--muted); font-size: 12px; word-break: break-all; text-align: right; max-width: 280px; }
    .srv-card .ms { font-size: 12px; color: var(--muted); white-space: nowrap; }
    .srv-card .ms.fast { color: var(--ok); }
    .srv-card .ms.slow { color: #fbbf24; }
    .srv-card.ok { border-left: 2px solid var(--ok); }
    .srv-card.err { border-left: 2px solid var(--bad); }

    .summary-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px 16px;
      margin-top: 16px;
      font-family: var(--mono);
      font-size: 13px;
      flex-wrap: wrap;
    }
    .summary-bar .count { color: var(--text); font-weight: 600; }
    .summary-bar .count .ok { color: var(--ok); }
    .summary-bar .count .err { color: var(--bad); }
    .summary-bar .elapsed { color: var(--muted); }
    .progress-bar { flex: 1; height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; min-width: 120px; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--ok), var(--accent)); border-radius: 2px; transition: width .3s; width: 0%; }
  </style>

  <main class="container">
    <div class="tool">
      <h1>DNS Propagation Checker</h1>
      <p class="sub">Query <b id="srvCount">600+</b> global DNS servers simultaneously. Free, no auth, instant results.</p>

      <div class="map-wrap">
        <div class="map-hint">scroll to zoom · drag to pan</div>
        <svg id="map" viewBox="0 0 960 500"></svg>
        <div class="map-legend">
          <span><span class="dot pending"></span> Pending</span>
          <span><span class="dot ok"></span> Resolved</span>
          <span><span class="dot err"></span> Failed</span>
        </div>
      </div>

      <div class="form">
        <div class="input-wrap">
          <input id="domain" type="text" autocomplete="off" spellcheck="false" maxlength="253"
            placeholder="example.com" autofocus>
        </div>
        <select id="rtype">
          <option value="A">A</option>
          <option value="AAAA">AAAA</option>
          <option value="CNAME">CNAME</option>
          <option value="MX">MX</option>
          <option value="NS">NS</option>
          <option value="TXT">TXT</option>
        </select>
        <button class="btn-big" id="go" style="padding: 0 24px; border-radius: 10px;">Check</button>
      </div>

      <div id="resultsArea">
        <div class="results-header" style="display: none;">
          <h2>Results</h2>
          <span class="count"><b id="doneCount">0</b>/<b id="totalCount">0</b></span>
        </div>
        <div id="resultsGrid" class="results-grid"></div>
        <div class="summary-bar" style="display: none;">
          <span class="count"><span class="ok" id="okCount">0</span> ok · <span class="err" id="failCount">0</span> failed</span>
          <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
          <span class="elapsed" id="elapsed"></span>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js" is:inline></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js" is:inline></script>
<script src="/prop-app.js" is:inline defer></script>
