---
import fs from 'node:fs';
import nodePath from 'node:path';
import * as d3 from 'd3';
import * as topojson from 'topojson-client';
import Layout from '../layouts/Layout.astro';

const root = process.cwd();
const dnsJson = JSON.parse(fs.readFileSync(nodePath.join(root, 'public/assets/dns.json'), 'utf8'));
const servers = dnsJson.filter((s) => s.active !== false);
const world = JSON.parse(
  fs.readFileSync(nodePath.join(root, 'public/assets/countries-110m.json'), 'utf8'),
);

const W = 960;
const H = 500;
const proj = d3.geoNaturalEarth1().scale(153).translate([W / 2, H / 2]).precision(0.1);
const path = d3.geoPath(proj);

const landPath = path(topojson.feature(world, world.objects.land));
const borderPath = path(topojson.mesh(world, world.objects.countries, (a, b) => a !== b));

const dots = servers.map((s) => {
  const p = proj([s.lng, s.lat]);
  return { ...s, x: Math.round(p[0] * 10) / 10, y: Math.round(p[1] * 10) / 10 };
});
---

<Layout
  title="DNS Propagation Checker"
  description="Check DNS propagation across 600+ global DNS servers. Free, no auth, instant results."
>
  <style is:global>
    .tool {
      margin: 48px auto 20px;
    }
    .tool h1 {
      font-size: clamp(32px, 5vw, 44px);
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 10px;
    }
    .tool .sub {
      color: var(--muted);
      font-size: 16px;
      margin-bottom: 28px;
    }
    .tool .sub b {
      color: var(--text);
      font-family: var(--mono);
    }

    .map-wrap {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 24px;
      overflow: hidden;
      position: relative;
    }
    .map-hint {
      position: absolute;
      top: 22px;
      right: 22px;
      z-index: 5;
      font-size: 11px;
      color: var(--muted);
      opacity: 0.6;
      pointer-events: none;
      font-family: var(--mono);
      background: rgba(5, 8, 12, 0.7);
      padding: 4px 8px;
      border-radius: 6px;
    }
    #map {
      width: 100%;
      display: block;
      cursor: grab;
      touch-action: none;
    }
    #map:active {
      cursor: grabbing;
    }
    #map .land {
      fill: #0c1520;
      stroke: #1e2d40;
      stroke-width: 0.4;
    }
    #map .border {
      fill: none;
      stroke: #1a2838;
      stroke-width: 0.25;
    }
    #map .graticule {
      fill: none;
      stroke: #0d1622;
      stroke-width: 0.35;
    }
    #map .sphere {
      fill: none;
      stroke: #182231;
      stroke-width: 0.6;
    }
    .srv-dot {
      cursor: pointer;
    }
    .srv-dot:hover {
      r: 6;
    }

    .map-legend {
      display: flex;
      gap: 16px;
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      flex-wrap: wrap;
      align-items: center;
    }
    .map-legend span {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .map-legend .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .map-legend .dot.pending {
      background: var(--muted);
      opacity: 0.4;
    }
    .map-legend .dot.ok {
      background: var(--ok);
    }
    .map-legend .dot.empty {
      background: #fbbf24;
    }
    .map-legend .dot.fail {
      background: var(--bad);
    }

    .form {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .form .input-wrap {
      flex: 1 1 160px;
    }
    .form select {
      flex: 0 0 auto;
    }
    .form .btn-big {
      padding: 0 24px;
      border-radius: 10px;
    }
    .input-wrap {
      flex: 1;
      min-width: 200px;
      display: flex;
      align-items: center;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      transition: border-color 0.15s;
    }
    .input-wrap:focus-within {
      border-color: var(--accent);
    }
    .input-wrap input {
      flex: 1;
      min-width: 60px;
      background: transparent;
      border: none;
      outline: none;
      color: var(--text);
      font-family: var(--mono);
      font-size: 15px;
      padding: 12px 14px;
    }
    .input-wrap input::placeholder {
      color: #4d5f76;
    }
    select {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      color: var(--text);
      font-family: var(--mono);
      font-size: 14px;
      padding: 12px 14px;
      cursor: pointer;
    }
    select:focus {
      outline: none;
      border-color: var(--accent);
    }

    .results-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 32px;
      margin-bottom: 16px;
    }
    .results-header h2 {
      font-size: 16px;
      font-weight: 700;
      color: var(--muted);
    }
    .results-header .count {
      font-family: var(--mono);
      font-size: 13px;
      color: var(--muted);
    }
    .country-group {
      margin-bottom: 14px;
    }
    .country-group h3 {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 6px 4px 8px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 8px;
    }
    .results-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      align-items: start;
    }
    @media (max-width: 860px) {
      .results-grid {
        grid-template-columns: 1fr;
      }
    }
    .srv {
      display: grid;
      grid-template-columns: 8px 1fr auto;
      gap: 14px;
      align-items: center;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px 16px;
      font-family: var(--mono);
      font-size: 13px;
      transition: border-color 0.2s, background 0.2s;
    }
    .srv:hover {
      border-color: #243448;
      background: var(--panel-2);
    }
    .srv .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .srv .dot.pending {
      background: var(--muted);
      opacity: 0.4;
    }
    .srv .dot.ok {
      background: var(--ok);
    }
    .srv .dot.empty {
      background: #fbbf24;
    }
    .srv .dot.fail {
      background: var(--bad);
    }
    .srv .info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .srv .name {
      font-weight: 600;
      color: var(--text);
      font-size: 13px;
    }
    .srv .region {
      font-size: 11px;
      color: var(--muted);
    }
    .srv .result {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      min-width: 0;
    }
    .srv .ips {
      color: var(--muted);
      font-size: 12px;
      word-break: break-all;
      text-align: right;
      max-width: 220px;
    }
    .srv .ms {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }
    .srv .ms.fast {
      color: var(--ok);
    }
    .srv .ms.slow {
      color: #fbbf24;
    }
    .srv.ok {
      border-left: 2px solid var(--ok);
    }
    .srv.empty {
      border-left: 2px solid #fbbf24;
    }
    .srv.fail {
      border-left: 2px solid var(--bad);
    }

    .summary-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px 16px;
      margin-bottom: 20px;
      font-family: var(--mono);
      font-size: 13px;
      flex-wrap: wrap;
    }
    .summary-bar .count {
      color: var(--text);
      font-weight: 600;
    }
    .summary-bar .count .ok {
      color: var(--ok);
    }
    .summary-bar .count .empty {
      color: #fbbf24;
    }
    .summary-bar .count .fail {
      color: var(--bad);
    }
    .summary-bar .elapsed {
      color: var(--muted);
    }
    .progress-bar {
      flex: 1;
      height: 4px;
      background: var(--line);
      border-radius: 2px;
      overflow: hidden;
      min-width: 120px;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--ok), var(--accent));
      border-radius: 2px;
      transition: width 0.3s;
      width: 0%;
    }

    .map-expand {
      margin-left: auto;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      padding: 5px 10px;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
    }
    .map-expand:hover {
      color: var(--text);
      border-color: var(--accent);
    }
    .map-wrap.expanded {
      position: fixed;
      inset: 0;
      z-index: 100;
      margin: 0;
      border: none;
      border-radius: 0;
      background: rgba(5, 8, 12, 0.97);
      padding: 16px;
      overflow: auto;
    }
    .map-wrap.expanded #map {
      width: 100%;
      height: calc(100vh - 150px);
    }
  </style>

  <main class="container">
    <div class="tool">
      <h1>DNS Propagation Checker</h1>
      <p class="sub">
        Query <b>{servers.length}</b> global DNS servers simultaneously. Free, no auth, instant
        results.
      </p>

      <div class="map-wrap">
        <div class="map-hint">scroll to zoom · drag to pan</div>
        <svg id="map" viewBox={`0 0 ${W} ${H}`}>
          <g id="mapg">
            <path class="sphere" d={path({ type: 'Sphere' })}></path>
            <path class="graticule" d={path(d3.geoGraticule().step([30, 30])())}></path>
            <path class="land" d={landPath}></path>
            <path class="border" d={borderPath}></path>
            {
              dots.map((s) => (
                <circle
                  class="srv-dot"
                  data-ip={s.ip}
                  cx={s.x}
                  cy={s.y}
                  r="3"
                  fill="#2a3a50"
                  opacity="0.5"
                >
                  <title>{s.label + ' (' + s.city + ', ' + s.country + ')'}</title>
                </circle>
              ))
            }
          </g>
        </svg>
        <div class="map-legend">
          <span><span class="dot pending"></span> Pending</span>
          <span><span class="dot ok"></span> Resolved</span>
          <span><span class="dot empty"></span> No records</span>
          <span><span class="dot fail"></span> Failed</span>
          <button id="mapExpand" class="map-expand" title="Expand map">Expand</button>
        </div>
      </div>

      <div class="form">
        <div class="input-wrap">
          <input
            id="domain"
            type="text"
            autocomplete="off"
            spellcheck="false"
            maxlength="253"
            placeholder="example.com"
            autofocus
          />
        </div>
        <select id="rtype">
          <option value="A">A</option>
          <option value="AAAA">AAAA</option>
          <option value="CNAME">CNAME</option>
          <option value="MX">MX</option>
          <option value="NS">NS</option>
          <option value="TXT">TXT</option>
        </select>
        <select id="viewmode">
          <option value="default">default</option>
          <option value="country">by country</option>
        </select>
        <button class="btn-big" id="go">Check</button>
      </div>

      <div id="resultsArea">
        <div class="results-header" style="display: none;">
          <h2>Results</h2>
          <span class="count"
            ><b id="doneCount">0</b>/<b id="totalCount">0</b></span
          >
        </div>
        <div class="summary-bar" style="display: none;">
          <span class="count"
            ><span class="ok" id="okCount">0</span> ok ·
            <span class="empty" id="emptyCount">0</span> empty ·
            <span class="fail" id="failCount">0</span> failed</span
          >
          <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
          <span class="elapsed" id="elapsed"></span>
        </div>
        <div id="resultsGrid" class="results-grid">
          {
            servers.map((s) => (
              <div class="srv" data-ip={s.ip} data-country={s.country} data-flag={s.flag}>
                <span class="dot pending"></span>
                <div class="info">
                  <span class="name">{s.flag + ' ' + s.label}</span>
                  <span class="region">{s.city + ', ' + s.country + ' · ' + s.ip}</span>
                </div>
                <div class="result">
                  <span class="ips">—</span>
                  <span class="ms"></span>
                </div>
              </div>
            ))
          }
        </div>
        <div id="countryGrid" style="display: none;"></div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const API = 'https://dqguiuyyhjqrrscncnnr.supabase.co/functions/v1/dns-propagate';
  const CHUNK = 25;

  const domainEl = document.getElementById('domain');
  const rtypeEl = document.getElementById('rtype');
  const goBtn = document.getElementById('go');
  const grid = document.getElementById('resultsGrid');
  const doneEl = document.getElementById('doneCount');
  const totalEl = document.getElementById('totalCount');
  const okEl = document.getElementById('okCount');
  const emptyEl = document.getElementById('emptyCount');
  const failEl = document.getElementById('failCount');
  const progressFill = document.getElementById('progressFill');
  const elapsedEl = document.getElementById('elapsed');
  const resultsHeader = document.querySelector('.results-header');
  const summaryBar = document.querySelector('.summary-bar');
  const viewmodeEl = document.getElementById('viewmode');
  const countryGrid = document.getElementById('countryGrid');
  const mapExpandBtn = document.getElementById('mapExpand');

  const servers = Array.from(grid.querySelectorAll('.srv')).map((el) => el.dataset.ip);
  const rowsByIp = new Map();
  const dotsByIp = new Map();
  const flatOrder = Array.from(grid.children);

  grid.querySelectorAll('.srv').forEach((el) => rowsByIp.set(el.dataset.ip, el));
  document.querySelectorAll('.srv-dot').forEach((el) => dotsByIp.set(el.dataset.ip, el));

  const countryNames = new Intl.DisplayNames('en', { type: 'region' });
  const nameOf = (c) => {
    try {
      return countryNames.of(c || 'ZZ');
    } catch {
      return c || 'Unknown';
    }
  };

  function applyViewMode() {
    if (viewmodeEl.value === 'country') {
      countryGrid.textContent = '';
      const groups = new Map();
      for (const row of flatOrder) {
        const c = row.dataset.country || 'ZZ';
        if (!groups.has(c)) groups.set(c, []);
        groups.get(c).push(row);
      }
      const sorted = [...groups.entries()].sort((a, b) => nameOf(a[0]).localeCompare(nameOf(b[0])));
      for (const [code, rows] of sorted) {
        const g = document.createElement('div');
        g.className = 'country-group';
        const h = document.createElement('h3');
        h.textContent = (rows[0].dataset.flag || '') + ' ' + nameOf(code) + ' · ' + rows.length;
        const cards = document.createElement('div');
        cards.className = 'results-grid';
        for (const r of rows) cards.appendChild(r);
        g.append(h, cards);
        countryGrid.appendChild(g);
      }
      grid.style.display = 'none';
      countryGrid.style.display = 'block';
    } else {
      for (const r of flatOrder) grid.appendChild(r);
      grid.style.display = 'grid';
      countryGrid.style.display = 'none';
      countryGrid.textContent = '';
    }
  }
  viewmodeEl.addEventListener('change', applyViewMode);

  const mapEl = document.getElementById('map');
  const mapG = document.getElementById('mapg');
  let k = 1, tx = 0, ty = 0;

  function applyTransform() {
    mapG.setAttribute('transform', `translate(${tx},${ty}) scale(${k})`);
    document.querySelectorAll('.srv-dot').forEach((d) => d.setAttribute('r', 3 / k));
  }

  mapEl.addEventListener('wheel', (e) => {
    e.preventDefault();
    const rect = mapEl.getBoundingClientRect();
    const sx = 960 / rect.width, sy = 500 / rect.height;
    const px = (e.clientX - rect.left) * sx, py = (e.clientY - rect.top) * sy;
    const k2 = Math.min(12, Math.max(1, k * Math.exp(-e.deltaY * 0.0015)));
    const f = k2 / k;
    tx = px - (px - tx) * f;
    ty = py - (py - ty) * f;
    k = k2;
    applyTransform();
  }, { passive: false });

  let dragging = false, startX = 0, startY = 0, startTx = 0, startTy = 0;
  mapEl.addEventListener('pointerdown', (e) => {
    dragging = true;
    startX = e.clientX; startY = e.clientY; startTx = tx; startTy = ty;
    mapEl.setPointerCapture(e.pointerId);
  });
  mapEl.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    tx = startTx + (e.clientX - startX);
    ty = startTy + (e.clientY - startY);
    applyTransform();
  });
  mapEl.addEventListener('pointerup', () => (dragging = false));
  mapEl.addEventListener('dblclick', () => {
    k = 1; tx = 0; ty = 0;
    applyTransform();
  });

  mapExpandBtn.addEventListener('click', () => {
    const wrap = document.querySelector('.map-wrap');
    const on = wrap.classList.toggle('expanded');
    mapExpandBtn.textContent = on ? 'Collapse' : 'Expand';
    mapExpandBtn.title = on ? 'Collapse map' : 'Expand map';
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.querySelector('.map-wrap.expanded')) {
      document.querySelector('.map-wrap').classList.remove('expanded');
      mapExpandBtn.textContent = 'Expand';
      mapExpandBtn.title = 'Expand map';
    }
  });

  function dotEl(ip) {
    return dotsByIp.get(ip);
  }

  function statusOf(r) {
    if (r.ok) return 'ok';
    if (r.resolveable === false) return 'empty';
    return 'fail';
  }

  function setStatus(ip, status, r) {
    const dot = dotEl(ip);
    if (dot) {
      dot.setAttribute('fill', status === 'ok' ? '#34d399' : status === 'empty' ? '#fbbf24' : '#f87171');
      dot.setAttribute('opacity', '1');
    }
    const row = rowsByIp.get(ip);
    if (!row) return;
    row.classList.remove('ok', 'empty', 'fail');
    row.classList.add(status);
    const dotSpan = row.querySelector('.dot');
    dotSpan.className = 'dot ' + status;
    const ips = row.querySelector('.ips');
    const ms = row.querySelector('.ms');
    if (r.ok) {
      let text = (r.answers || []).join(', ');
      if (text.length > 160) text = text.slice(0, 160) + '…';
      ips.textContent = text || '—';
    } else if (status === 'empty') {
      ips.textContent = 'no records';
    } else {
      ips.textContent = '—';
    }
    if (r.ms != null) {
      ms.textContent = r.ms + 'ms';
      ms.className = 'ms' + (r.ms < 100 ? ' fast' : r.ms > 500 ? ' slow' : '');
    } else {
      ms.textContent = 'timeout';
      ms.className = 'ms';
    }
  }

  const counts = { ok: 0, empty: 0, fail: 0, done: 0 };

  function renderSummary(t0) {
    doneEl.textContent = counts.done;
    totalEl.textContent = servers.length;
    okEl.textContent = counts.ok;
    emptyEl.textContent = counts.empty;
    failEl.textContent = counts.fail;
    progressFill.style.width = Math.round((counts.done / servers.length) * 100) + '%';
    if (counts.done === servers.length) {
      elapsedEl.textContent = Math.round(performance.now() - t0) + 'ms total';
    }
  }

  async function postChunk(chunk, domain, type, signal) {
    const res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      signal,
      body: JSON.stringify({ domain, type, servers: chunk }),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return res.json();
  }

  async function check() {
    let d = domainEl.value.trim().toLowerCase().replace(/^https?:\/\//, '').split('/')[0];
    if (!d) return;
    goBtn.disabled = true;
    goBtn.textContent = 'Checking…';
    resultsHeader.style.display = 'flex';
    summaryBar.style.display = 'flex';
    servers.forEach((ip) => setStatus(ip, 'pending', { ok: false, resolveable: null, ms: null }));
    counts.ok = counts.empty = counts.fail = counts.done = 0;
    renderSummary(0);
    elapsedEl.textContent = '';

    const t0 = performance.now();
    const type = rtypeEl.value;
    const chunks = [];
    for (let i = 0; i < servers.length; i += CHUNK) chunks.push(servers.slice(i, i + CHUNK));

    await Promise.all(
      chunks.map(async (chunk) => {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 45000);
        try {
          const res = await postChunk(chunk, d, type, controller.signal);
          for (const r of res.results) {
            const st = statusOf(r);
            counts[st]++;
            counts.done++;
            setStatus(r.ip, st, r);
          }
        } catch (e) {
          for (const ip of chunk) {
            counts.fail++;
            counts.done++;
            setStatus(ip, 'fail', { ok: false, resolveable: null, ms: null });
          }
        } finally {
          clearTimeout(timer);
          renderSummary(t0);
        }
      }),
    );

    elapsedEl.textContent = Math.round(performance.now() - t0) + 'ms total';
    goBtn.disabled = false;
    goBtn.textContent = 'Check';
  }

  goBtn.addEventListener('click', check);
  domainEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') check();
  });
</script>
