---
import Layout from '../layouts/Layout.astro';

// Read all changelog markdown files
const changelogFiles = Object.values(import.meta.glob('../content/changelogs/*.md', { eager: true }));

// Sort by date (newest first)
const sorted = changelogFiles
  .map(file => ({
    version: file.frontmatter.version,
    date: file.frontmatter.date,
    content: file.compiledContent()
  }))
  .sort((a, b) => new Date(b.date) - new Date(a.date));

function formatDate(dateStr) {
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Layout title="Changelog" description="Track every update, improvement, and fix on oxyd.space.">
  <main class="container" style="padding-top: 60px; padding-bottom: 60px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <h1 style="font-size: clamp(32px, 5vw, 48px); font-weight: 800; letter-spacing: -.03em; margin-bottom: 12px;">Changelog</h1>
      <p style="color: var(--muted); font-size: 17px;">Track every update, improvement, and fix on oxyd.space.</p>
    </div>

    <div class="changelog-timeline">
      {sorted.map(entry => (
        <article class="changelog-entry">
          <div class="entry-header">
            <span class="badge">{entry.version}</span>
            <time class="date">{formatDate(entry.date)}</time>
          </div>
          <div class="entry-body" set:html={entry.content} />
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  .changelog-timeline {
    position: relative;
    max-width: 740px;
    margin: 0 auto;
    padding-left: 28px;
  }
  .changelog-timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .changelog-entry {
    position: relative;
    margin-bottom: 48px;
  }
  .changelog-entry::before {
    content: "";
    position: absolute;
    left: -28px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 2px var(--accent);
  }
  .entry-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .entry-header .badge {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    padding: 4px 14px;
    border-radius: 999px;
  }
  .entry-header .date {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .entry-body :global(h2) {
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    margin-bottom: 10px;
    margin-top: 16px;
  }
  .entry-body :global(h2:first-child) {
    margin-top: 0;
  }
  .entry-body :global(ul) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .entry-body :global(li) {
    color: var(--muted);
    font-size: 14px;
    padding-left: 18px;
    position: relative;
  }
  .entry-body :global(li::before) {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
</style>
