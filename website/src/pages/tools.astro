---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tools" description="Utilities to help you manage and monitor your oxyd.space subdomains.">
  <main class="container" style="padding-top: 60px; padding-bottom: 60px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <h1 style="font-size: clamp(32px, 5vw, 48px); font-weight: 800; letter-spacing: -.03em; margin-bottom: 12px;">Tools</h1>
      <p style="color: var(--muted); font-size: 17px;">Utilities to help you manage and monitor your subdomains.</p>
    </div>

    <div class="tools-grid">
      <a href="/checker" class="tool-card">
        <div class="tool-icon">🔍</div>
        <h3>Availability Checker</h3>
        <p>Check if a subdomain is free before registering.</p>
      </a>
      <a href="/propagation" class="tool-card">
        <div class="tool-icon">🌐</div>
        <h3>DNS Propagation</h3>
        <p>Check DNS propagation across 32 global servers.</p>
      </a>
      <a href="/changelog" class="tool-card">
        <div class="tool-icon">📋</div>
        <h3>Changelog</h3>
        <p>Track every update and improvement on oxyd.space.</p>
      </a>
      <a href="/dashboard" class="tool-card">
        <div class="tool-icon">👤</div>
        <h3>Personal Dashboard</h3>
        <p>Manage your subdomains from one place.</p>
      </a>
    </div>
  </main>
</Layout>
